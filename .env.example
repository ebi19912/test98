# .env.example - تنظیمات پلتفرم تست ۹۸ (test98.ir)

# تنظیمات عمومی وب‌سرور
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=test98-super-secure-secret-key-change-in-production
SITE_URL=https://test98.ir

# دیتابیس SQLite
DATABASE_PATH=test98.db

# تنظیمات کلاینت تلگرام (Telethon Userbot)
# دریافت از https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=test98_userbot
TELEGRAM_ENABLED=false

# تنظیمات بات بله (Bale Messenger)
# دریافت از @BotFather در بله
BALE_BOT_TOKEN=your_bale_bot_token_here
BALE_BOT_USERNAME=Test98Bot
BALE_CHANNEL_ID=@test98_ir
BALE_ENABLED=false
